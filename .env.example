# Application Settings
APP_NAME=wilco
APP_VERSION=0.1.0
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./wilco.db

# Cryptographic Vault Configuration
# 32-byte base64-encoded key (generated via: uv run python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
VAULT_MASTER_KEY=

# Companion Web App Configuration
COMPANION_BASE_URL=http://localhost:8000/companion
COMPANION_TOKEN_TTL_MINUTES=10

# Concurrency & Execution Limits (from Step 2 Gaps)
MAX_CONCURRENT_BROWSERS=2
TASK_TIMEOUT_SECONDS=300

# Telegram Bot Configuration
# Paste your bot token from @BotFather here:
TELEGRAM_BOT_TOKEN=
# Mode: "webhook" (production/tunnel) or "polling" (local dev)
BOT_MODE=webhook
# Base public URL for webhook (e.g. https://your-domain.up.railway.app or https://xxxx.ngrok-free.app)
TELEGRAM_WEBHOOK_URL=
# Secret token to authenticate Telegram webhook requests (random string)
TELEGRAM_WEBHOOK_SECRET=
# Telegram Webhook path
WEBHOOK_PATH=/webhook/telegram

# Browser Engine Configuration
# Type: "local" (uses local Chromium) or "browserbase" (remote cloud browser)
BROWSER_TYPE=local
# Run in background (headless) or show browser window
BROWSER_HEADLESS=true
# Optional Browserbase credentials (if using cloud sessions)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Step 4 Security Hardening: Disable browser-use external telemetry tracking
ANONYMIZED_TELEMETRY=false

# LLM Provider Configuration
# Supported providers: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini
# Default model for the selected provider (e.g., gemini-3.8-flash, gpt-4o, claude-3-5-sonnet-20241022)
LLM_MODEL=gemini-3.8-flash
# API Keys (configure the one matching your LLM_PROVIDER)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
