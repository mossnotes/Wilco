# Copy this file to .env. Never commit .env or share its contents.

# Required for Telegram. Create a bot with https://t.me/BotFather.
TELEGRAM_BOT_TOKEN=
# Polling works locally without an incoming public webhook.
BOT_MODE=polling

# Required for the encrypted Vault. Generate once and keep a secure backup:
# uv run python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY=

# Choose gemini, openai, or anthropic and a model available to your account.
# Set only the API key for your chosen provider.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as a fallback for GEMINI_API_KEY.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Vault buttons require a public HTTPS URL reachable from Telegram.
# During local development, use an HTTPS tunnel to port 8000.
# Hostname only; Wilco appends the /vault paths automatically.
VAULT_BASE_URL=http://localhost:8000

# SQLite is the default. In Docker, mount the containing directory persistently.
DATABASE_URL=sqlite+aiosqlite:///./wilco.db
# PostgreSQL alternative: postgresql+asyncpg://user:password@host:5432/wilco

# Local Chromium is installed with: uv run playwright install chromium
BROWSER_TYPE=local
BROWSER_HEADLESS=true
# For BROWSER_TYPE=browserbase, configure both values:
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# One active browser task per chat. There is no global queue or browser limit.
TASK_TIMEOUT_SECONDS=300
ROUTING_TIMEOUT_SECONDS=60

# For production webhooks, set BOT_MODE=webhook and configure these values.
# TELEGRAM_WEBHOOK_URL is the base URL; WEBHOOK_PATH is appended automatically.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# WEBHOOK_PATH=/webhook/telegram

# Leave telemetry and detailed payload logging off for normal use.
ANONYMIZED_TELEMETRY=false
DEBUG=false
LOG_LEVEL=INFO
# TELEGRAM_DEBUG_STATUS=false

# Conversation memory is enabled by default and stored in the database.
# CONVERSATION_MEMORY_ENABLED=true
# CONVERSATION_RECENT_MESSAGES=20
# CONVERSATION_SUMMARY_MAX_CHARS=4000
# CONVERSATION_CONTEXT_MAX_CHARS=24000
